# JNshop Environment Configuration Template
DATABASE_URL="file:./dev.db" # or "postgresql://postgres:password@localhost:5432/jnshop?schema=public"

# Authentication & Security
JWT_SECRET="replace-with-a-random-secure-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Assistant (Google Gemini API)
GEMINI_API_KEY="your-gemini-api-key-here"

# WhatsApp Business / Notifications
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_DEFAULT_ADMIN_NUMBER="6281234567890"

# Email Notifications (Resend / SMTP)
RESEND_API_KEY=""
EMAIL_FROM="orders@jnshop.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Payment Gateway (Midtrans)
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Payment Gateway (Xendit)
XENDIT_SECRET_KEY=""
