# ==============================================================================
# JNSHOP - TEMPLATE ENVIRONMENT VARIABLES UNTUK VERCEL & PRODUKSI
# Salin nilai-nilai ini ke menu: Project Settings > Environment Variables di Vercel
# ==============================================================================

# 1. DATABASE (Wajib - PostgreSQL Cloud Gratis via Supabase / Neon / Vercel Postgres)
# Contoh Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# Contoh Neon: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# 2. KEAMANAN & SESI (Wajib)
# Masukkan string acak panjang dan aman untuk mengenkripsi JWT login pelanggan & admin
JWT_SECRET="ganti-dengan-string-rahasia-acak-panjang-minimal-32-karakter-2026"

# 3. URL APLIKASI (Wajib)
# Domain live Vercel Anda (contoh: https://jnshop.vercel.app atau domain custom https://jnshop.id)
NEXT_PUBLIC_APP_URL="https://jnshop.vercel.app"

# 4. PENYIMPANAN CLOUD GAMBAR (Vercel Blob Storage)
# Di dashboard Vercel, buka tab "Storage" > klik "Create Database" > pilih "Blob".
# Token ini otomatis terpasang oleh Vercel, atau salin manual jika diperlukan:
BLOB_READ_WRITE_TOKEN=""

# 5. GOOGLE GEMINI AI ASSISTANT (Toko & Bantuan Produk)
# Dapatkan gratis di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 6. EMAIL NOTIFIKASI OTOMATIS & PENGIRIMAN QRIS (Admin & Pelanggan)
ADMIN_NOTIFICATION_EMAIL="jaidav.enggineernes@gmail.com"
EMAIL_FROM="JNshop Store <jaidav.enggineernes@gmail.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="jaidav.enggineernes@gmail.com"
# Masukkan 16 karakter Sandi Aplikasi (Google App Password) dari akun Google Anda
SMTP_PASS=""

# Alternatif Resend API jika tidak memakai SMTP Gmail (Opsional)
RESEND_API_KEY=""

# 7. WHATSAPP CLICK-TO-CHAT & NOTIFIKASI
ADMIN_NOTIFICATION_WHATSAPP="6285191219129"
WHATSAPP_DEFAULT_ADMIN_NUMBER="6285191219129"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# 8. PAYMENT GATEWAY MIDTRANS (Opsional jika mengaktifkan transfer virtual account otomatis)
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
