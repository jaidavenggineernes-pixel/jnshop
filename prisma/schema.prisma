// Prisma Schema for JNshop - Personal E-Commerce Platform
// Supports all 22 entities specified in the architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. Users
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  role          String    @default("CUSTOMER") // "ADMIN", "CUSTOMER"
  avatar        String?
  emailVerified DateTime?
  phoneVerified DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       UserProfile?
  addresses     Address[]
  orders        Order[]
  carts         Cart[]
  wishlists     Wishlist[]
  reviews       Review[]
  notifications Notification[]
  conversations Conversation[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([role])
}

// 2. UserProfiles
model UserProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio              String?
  dateOfBirth      DateTime?
  gender           String?   // "MALE", "FEMALE", "OTHER"
  defaultAddressId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// 3. Addresses
model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  phone         String
  streetAddress String
  province      String
  city          String
  district      String
  postalCode    String
  isPrimary     Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// 4. Products
model Product {
  id                 String           @id @default(cuid())
  name               String
  slug               String           @unique
  description        String
  shortDescription   String?
  price              Float
  discountPrice      Float?
  stock              Int              @default(0)
  sku                String?          @unique
  weight             Float            @default(0.5) // in kilograms (for physical goods)
  isPhysical         Boolean          @default(true) // true: physical, false: digital
  digitalDeliveryType String?         // "INSTANT_DOWNLOAD", "LICENSE_KEY", "MANUAL_EMAIL"
  digitalFileUrl     String?
  digitalLicenseKey  String?
  allowCod           Boolean          @default(true) // If false, COD cannot be used for this product (always false for digital goods)
  allowedPaymentMethods String?       // JSON array e.g. ["QRIS_INSTANT","BCA_MANUAL","MANDIRI_MANUAL","BNI_VA"]
  isActive           Boolean          @default(true)
  isFeatured         Boolean          @default(false)
  rating             Float            @default(5.0)
  reviewCount        Int              @default(0)
  categoryId         String
  category           Category         @relation(fields: [categoryId], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  images             ProductImage[]
  variants           ProductVariant[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  wishlists          Wishlist[]
  reviews            Review[]

  @@index([slug])
  @@index([categoryId])
  @@index([isActive, isFeatured])
}

// 5. ProductImages
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

// 6. Categories
model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  description  String?
  icon         String?    // Lucide icon name or emoji
  image        String?
  parentId     String?
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryHierarchy")
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  products     Product[]

  @@index([slug])
}

// 7. ProductVariants
model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String      // e.g. "Color: Midnight Black / Size: L"
  sku            String?     @unique
  price          Float?      // If different from base product
  stock          Int         @default(0)
  attributesJson String?     // e.g. {"color":"Black", "size":"L"}
  imageUrl       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([productId])
}

// 8. Carts
model Cart {
  id           String     @id @default(cuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  items        CartItem[]

  @@index([userId])
  @@index([sessionToken])
}

// 9. CartItems
model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)
  price     Float
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([cartId])
  @@index([productId])
}

// 10. Wishlists
model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// 11. Orders
model Order {
  id                  String      @id @default(cuid())
  orderNumber         String      @unique // e.g. "JN-20261107-ABCD"
  userId              String?
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Status flow:
  // PENDING_PAYMENT -> WAITING_CONFIRMATION -> PAID -> PROCESSING -> READY_TO_SHIP -> SHIPPED -> DELIVERED / CANCELLED / REFUNDED
  status              String      @default("PENDING_PAYMENT")
  
  totalAmount         Float       // Subtotal of items
  discountAmount      Float       @default(0)
  shippingFee         Float       @default(0)
  taxAmount           Float       @default(0)
  grandTotal          Float       // Final total
  
  notes               String?
  shippingAddressJson String?     // Serialized snapshot of delivery address
  recipientName       String
  recipientPhone      String
  customerEmail       String?     // Email of buyer (mandatory for QRIS dynamic issuance)
  
  cancelReason        String?
  trackingNumber      String?     // Resi pengiriman
  courierName         String?     // JNE, SiCepat, J&T, etc.
  
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  items               OrderItem[]
  payments            Payment[]
  shipments           Shipment[]
  reviews             Review[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
}

// 12. OrderItems
model OrderItem {
  id                     String          @id @default(cuid())
  orderId                String
  order                  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId              String
  product                Product         @relation(fields: [productId], references: [id])
  variantId              String?
  variant                ProductVariant? @relation(fields: [variantId], references: [id])
  
  productName            String
  productPrice           Float
  quantity               Int
  subtotal               Float
  isDigital              Boolean         @default(false)
  digitalAccessDelivered Boolean         @default(false)
  digitalAccessCode      String?         // License key or access token
  createdAt              DateTime        @default(now())

  @@index([orderId])
  @@index([productId])
}

// 13. Payments
model Payment {
  id                    String         @id @default(cuid())
  orderId               String
  order                 Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod         String         // "QRIS", "BANK_TRANSFER", "VIRTUAL_ACCOUNT", "EWALLET", "MANUAL_TRANSFER", "COD"
  paymentChannel        String?        // "BCA", "MANDIRI", "GOPAY", "MIDTRANS", etc.
  transactionId         String?        // From payment gateway or reference
  amount                Float
  
  // Status: "PENDING", "PAID", "FAILED", "EXPIRED", "REFUNDED"
  status                String         @default("PENDING")
  
  paymentProofUrl       String?        // For manual transfer receipts
  adminVerifiedBy       String?
  adminVerifiedAt       DateTime?
  adminVerificationNote String?
  paymentGatewayPayload String?        // Raw JSON callback response
  
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([orderId])
  @@index([status])
}

// 14. PaymentMethods
model PaymentMethod {
  id           String   @id @default(cuid())
  code         String   @unique // "BCA_MANUAL", "MANDIRI_MANUAL", "QRIS_INSTANT", "MIDTRANS_SNAP", "COD"
  name         String
  type         String   // "BANK_TRANSFER", "VIRTUAL_ACCOUNT", "EWALLET", "QRIS", "MANUAL_TRANSFER", "COD"
  description  String?
  instructions String?
  accountName  String?
  accountNumber String?
  logoUrl      String?
  qrCodeUrl    String?  // Static QRIS image if applicable
  minAmount    Float?   @default(0)
  maxAmount    Float?   // Limit e.g. for COD max Rp 1.500.000 to prevent fraud
  isForPhysicalOnly Boolean @default(false) // If true, strictly forbidden if cart contains digital goods
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type])
  @@index([isActive])
}

// 15. Shipments
model Shipment {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierName    String    // JNE, SiCepat, J&T, POS Indonesia, Instant
  service        String?   // REG, YES, BEST, Cargo
  trackingNumber String?
  status         String    @default("PENDING") // "PENDING", "PICKED_UP", "IN_TRANSIT", "OUT_FOR_DELIVERY", "DELIVERED"
  estimatedDays  String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orderId])
}

// 16. Reviews
model Review {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int      @default(5)
  title       String?
  comment     String
  mediaUrls   String?  // JSON array of image URLs
  isModerated Boolean  @default(false)
  isApproved  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([userId])
}

// 17. Coupons
model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  type        String    @default("PERCENTAGE") // "PERCENTAGE", "FIXED"
  value       Float     // e.g. 10 for 10% or 50000 for Rp 50.000
  minPurchase Float     @default(0)
  maxDiscount Float?    // Max discount cap for percentage vouchers
  quota       Int       @default(100)
  usedCount   Int       @default(0)
  startDate   DateTime  @default(now())
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
}

// 18. Notifications
model Notification {
  id        String   @id @default(cuid())
  userId    String?  // Null means broadcast or admin notification
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM") // "ORDER", "PAYMENT", "PROMO", "SYSTEM", "STOCK_ALERT"
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

// 19. Conversations (for JNshop AI Shopping Assistant & Customer Support)
model Conversation {
  id           String        @id @default(cuid())
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionToken String?
  status       String        @default("ACTIVE") // "ACTIVE", "ESCALATED_TO_WHATSAPP", "RESOLVED"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  messages     ChatMessage[]

  @@index([userId])
  @@index([sessionToken])
}

// 20. ChatMessages
model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String       // "USER", "ASSISTANT", "ADMIN"
  message        String
  metadataJson   String?      // e.g. recommended product IDs or actions
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// 21. StoreSettings
model StoreSetting {
  id                  String   @id @default("default")
  storeName           String   @default("JNshop")
  tagLine             String   @default("Toko Online Pribadi Terpercaya")
  description         String   @default("Pusat belanja produk fisik berkualitas, produk digital terlengkap, dan layanan profesional terbaik.")
  logoUrl             String?
  email               String   @default("owner@jnshop.com")
  phone               String   @default("+6281234567890")
  whatsappNumber      String   @default("6281234567890")
  address             String   @default("Jakarta, Indonesia")
  socialMediaJson     String?  // JSON e.g. {"instagram":"jnshop.id", "tiktok":"@jnshop"}
  currency            String   @default("IDR")
  maintenanceMode     Boolean  @default(false)
  bannerAnnouncement  String?
  termsAndConditions  String?
  privacyPolicy       String?
  returnPolicy        String?
  geminiApiKey        String?
  aiModel             String?  @default("gemini-2.5-flash")

  // 21.1 Homepage Hero CMS
  heroBadge           String?  @default("Kurasi Khusus • Toko Pribadi & Digital Studio")
  heroTitle           String?  @default("Peralatan kerja pilihan & aset digital siap pakai, dibuat dengan rasa & dedikasi.")
  heroSubtitle        String?
  heroPrimaryBtnText  String?  @default("Lihat Seluruh Koleksi")
  heroPrimaryBtnLink  String?  @default("/products")
  heroSecondaryBtnText String? @default("⚡ Produk Digital & Lisensi")
  heroSecondaryBtnLink String? @default("/categories/produk-digital-lisensi")

  // 21.2 Trust Guarantees (3 boxes)
  guarantee1Title     String?  @default("Garansi 7 Hari")
  guarantee1Desc      String?  @default("Retur ganti baru / refund")
  guarantee2Title     String?  @default("0 Detik")
  guarantee2Desc      String?  @default("Lisensi digital langsung aktif")
  guarantee3Title     String?  @default("Personal")
  guarantee3Desc      String?  @default("Dukungan pemilik toko")

  // 21.3 Curated Flagship Showcase Card (shown in hero)
  showcaseBadgeLeft   String?  @default("Rekomendasi Minggu Ini")
  showcaseBadgeRight  String?  @default("Kurasi Edisi 2026")
  showcaseImageUrl    String?  @default("https://images.unsplash.com/photo-1595225476474-87563907a212?w=800&auto=format&fit=crop&q=80")
  showcaseTagPill     String?  @default("Keychron K2 Pro • Hot-Swap")
  showcaseTitle       String?  @default("Workstation Setup Terpopuler")
  showcaseSubtitle    String?  @default("Mekanikal keyboard & stand laptop aluminium 360°")
  showcaseLinkText    String?  @default("Buka Detail →")
  showcaseLinkUrl     String?  @default("/products")
  showcaseConsultText String?  @default("Butuh panduan sebelum membeli?")

  updatedAt           DateTime @updatedAt
}

// 22. AuditLogs
model AuditLog {
  id          String   @id @default(cuid())
  adminId     String?
  admin       User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action      String   // "PRODUCT_CREATE", "PAYMENT_VERIFIED", "ORDER_STATUS_UPDATE", "SETTINGS_CHANGED"
  entityType  String   // "PRODUCT", "ORDER", "PAYMENT", "STORE_SETTING"
  entityId    String?
  detailsJson String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([action])
}
